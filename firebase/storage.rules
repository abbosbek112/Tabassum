rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    // Fix #3: Any signed-in user could upload to any shop folder.
    // Now restricted to: images only, max 5MB.
    // Full owner-only enforcement requires Custom Claims (future improvement).
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.size < 5 * 1024 * 1024          // max 5 MB
        && request.resource.contentType.matches('image/.*'); // images only
    }
  }
}
